# ---------------------------------------------------------------------------
# این فایل را دو بار کپی کنید:
#   cp .env.example agent/.env.local
#   cp .env.example frontend/.env.local
# سپس مقادیر را پر کنید. فایل‌های .env.local هرگز کامیت نمی‌شوند.
# ---------------------------------------------------------------------------

# --- LiveKit (هر دو بخش لازم دارند) ---
# از داشبورد LiveKit Cloud یا سرور self-hosted خودتان
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# --- OpenAI (فقط agent/) ---
# مدل Realtime برای گفت‌وگوی صوتی استفاده می‌شود
OPENAI_API_KEY=
# مدل Realtime؛ خالی بگذارید تا gpt-realtime استفاده شود
OPENAI_REALTIME_MODEL=gpt-realtime
# صدای مدل؛ خالی بگذارید تا cedar (لحن مردانه‌ی بم) استفاده شود
OPENAI_VOICE=cedar

# --- Beyond Presence (فقط agent/) ---
# آواتار تصویری‌ای که در اتاق حاضر می‌شود.
# اگر BEY_AVATAR_ID خالی بماند، ایجنت بدون آواتار تصویری بالا می‌آید و فقط
# گفت‌وگوی صوتی کار می‌کند (برای تست سریع مفید است).
BEY_API_KEY=
BEY_AVATAR_ID=

# --- نویزگیری (فقط agent/) ---
# کدام نویزگیر روی ورودی صدا اعمال شود. خالی یعنی ai-coustics.
#   ai-coustics     پیش‌فرض؛ از اعتبارنامه‌ی LiveKit Cloud استفاده می‌کند و کلید جدا نمی‌خواهد
#   bvc             نویزگیر لایوکیت؛ صدای انسان‌های پس‌زمینه را هم حذف می‌کند
#   bvc-telephony   نسخه‌ی BVC برای صدای باند-باریک تلفنی
#   nc              نویزگیری ساده، بدون حذف صدای انسان‌های دیگر
#   off             خاموش
# مقدار ناشناخته باعث خطای روشن هنگام شروع می‌شود، نه بازگشت بی‌صدا به پیش‌فرض.
NOISE_CANCELLATION=ai-coustics

# مدل ai-coustics؛ فقط وقتی NOISE_CANCELLATION=ai-coustics است اثر دارد.
# گزینه‌ها: QUAIL_VF_S (پیش‌فرض)، QUAIL_VF_L، QUAIL_L، ROOK_S، SPARROW_S
AI_COUSTICS_MODEL=QUAIL_VF_S

# اگر با bvc/bvc-telephony/nc روی پردازنده‌ی AMD کرش گرفتید، این را تنظیم کنید.
# علتش تشخیص غلط CPU در OpenBLAS است و از پیام کرش قابل حدس نیست.
# OPENBLAS_CORETYPE=Haswell

# --- Gmail برای ارسال ایمیل تیکت (فقط agent/) ---
# GMAIL_APP_PASSWORD باید «رمز اپلیکیشن» باشد، نه رمز اصلی حساب:
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- اختیاری: مسیر فایل کاربران مسدودشده (فقط agent/) ---
# اگر خالی بماند، به‌صورت پیش‌فرض demo-app/public/blockusers.txt استفاده می‌شود
BLOCK_USERS_FILE=

# ---------------------------------------------------------------------------
# پایگاه داده‌ی مشترک و پنل ادمین
# ---------------------------------------------------------------------------
# پنل ادمین می‌نویسد و ایجنت می‌خواند، پس هر دو باید به یک فایل اشاره کنند.
# اول یک بار اسکیما را بسازید:  node db/migrate.mjs
# خالی یعنی <ریشه‌ی مخزن>/data/ostandari.db
DATABASE_PATH=

# کلید اصلی رمزنگاری کلیدهای API داخل پایگاه داده و امضای کوکی نشست ادمین.
# دقیقاً ۳۲ بایت به‌صورت base64. با این دستور بسازید:
#   openssl rand -base64 32
# ⚠️ اگر این کلید را عوض کنید، کلیدهای ذخیره‌شده در پنل دیگر خوانده نمی‌شوند و
#    باید دوباره واردشان کنید. ایجنت در آن حالت به متغیرهای محیطی برمی‌گردد.
# ⚠️ اگر خالی بماند، پنل ادمین بالا نمی‌آید.
ENCRYPTION_KEY=

# رمز ورود پنل ادمین (فقط frontend/). خالی یعنی پنل غیرفعال است.
# ⚠️ این یک راز مشترک است، نه حساب کاربری: همه‌ی ادمین‌ها یک رمز دارند و ردی از
#    اینکه چه کسی چه چیزی را عوض کرده نمی‌ماند.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# امنیت — جزئیات و محدودیت‌های شناخته‌شده در SECURITY.md
# ---------------------------------------------------------------------------

# --- کنترل دسترسی به گفت‌وگو (فقط frontend/) ---
# اگر تنظیم شود، کاربر پیش از شروع گفت‌وگو باید این کد را وارد کند.
# خالی بگذارید تا فقط محدودیت نرخ فعال بماند (مناسب دمو، نه استقرار عمومی).
ACCESS_CODE=

# سقف درخواست توکن در دقیقه، به ازای هر IP. خالی یعنی ۱۰.
# ⚠️ این شمارنده در حافظه است و روی چند نمونه یا سرورلس قابل دور زدن است.
RATE_LIMIT_PER_MINUTE=10

# مدت اعتبار توکن LiveKit. خالی یعنی 15m.
TOKEN_TTL=15m

# --- مهار ابزارهای ایجنت (فقط agent/) ---
# دامنه‌های مجاز برای ارسال ایمیل، با کاما جدا شده. مثال:
#   EMAIL_ALLOWED_DOMAINS=ostandari.ir,example.com
# ⚠️ اگر خالی بماند، ایجنت می‌تواند از حساب جیمیل شما به هر نشانی ایمیل بفرستد.
EMAIL_ALLOWED_DOMAINS=

# سقف تعداد فراخوانی هر ابزار در یک گفت‌وگو
EMAIL_MAX_PER_SESSION=3
UNBLOCK_MAX_PER_SESSION=5

# --- اختیاری: پیکربندی سندباکس LiveKit (فقط frontend/) ---
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
